<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="761.0" prefWidth="1280.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="pokemon.Controller.EntrenamientoController">

    <!-- Fondo igual que el menu -->
    <ImageView fitHeight="761.0" fitWidth="1280.0" pickOnBounds="true">
        <image><Image url="@images/ImagenMenu.png" /></image>
    </ImageView>

    <AnchorPane prefHeight="761.0" prefWidth="1280.0">

        <!-- Panel principal centrado -->
        <VBox alignment="TOP_CENTER" spacing="20.0"
            style="-fx-background-color: rgba(0,40,80,0.75);
                   -fx-background-radius: 20;"
            prefWidth="700.0"
            AnchorPane.topAnchor="40.0"
            AnchorPane.bottomAnchor="40.0"
            AnchorPane.leftAnchor="290.0"
            AnchorPane.rightAnchor="290.0">

            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

            <!-- Titulo -->
            <Label text="ENTRENAMIENTO"
                alignment="CENTER"
                prefWidth="640.0"
                prefHeight="60.0"
                textFill="WHITE"
                style="-fx-background-color: #2c5d8f;
                       -fx-border-color: #d4af37;
                       -fx-border-width: 4;
                       -fx-border-radius: 10;
                       -fx-background-radius: 10;">
                <font><Font name="Pokemon Solid Normal" size="22.0" /></font>
            </Label>

            <!-- Pokedollars del jugador -->
            <Label fx:id="lblPokedollars" text="Tus Pokedollars: 0 ₽"
                textFill="#ffd700"
                style="-fx-background-color: rgba(0,0,0,0.3);
                       -fx-background-radius: 8;
                       -fx-padding: 6 16 6 16;">
                <font><Font name="Pokemon Solid Normal" size="14.0" /></font>
            </Label>

            <!-- Separador -->
            <Label text="Elige un Pokemon y un tipo de entrenamiento"
                textFill="rgba(255,255,255,0.7)"
                style="-fx-font-size: 12px;"/>

            <!-- ComboBox Pokemon -->
            <VBox spacing="6.0">
                <Label text="Pokemon a entrenar:" textFill="WHITE">
                    <font><Font name="Pokemon Solid Normal" size="12.0" /></font>
                </Label>
                <ComboBox fx:id="comboPokemon"
                    prefWidth="640.0" prefHeight="40.0"
                    promptText="Selecciona un Pokemon..."
                    style="-fx-background-color: rgba(255,255,255,0.9);
                           -fx-background-radius: 8;
                           -fx-font-size: 13px;" />
            </VBox>

            <!-- ComboBox Entrenamiento -->
            <VBox spacing="6.0">
                <Label text="Tipo de entrenamiento:" textFill="WHITE">
                    <font><Font name="Pokemon Solid Normal" size="12.0" /></font>
                </Label>
                <ComboBox fx:id="comboEntrenamiento"
                    prefWidth="640.0" prefHeight="40.0"
                    promptText="Selecciona un entrenamiento..."
                    style="-fx-background-color: rgba(255,255,255,0.9);
                           -fx-background-radius: 8;
                           -fx-font-size: 11px;" />
            </VBox>

            <!-- Info de los entrenamientos -->
            <VBox spacing="4.0"
                style="-fx-background-color: rgba(0,0,0,0.3);
                       -fx-background-radius: 10;
                       -fx-padding: 12 16 12 16;">
                <Label text="Tipos de entrenamiento:" textFill="#ffd700">
                    <font><Font size="11.0" /></font>
                </Label>
                <Label text="⚫ Pesado (20×Nv) — +Def, +DefEsp, +Vida" textFill="rgba(255,255,255,0.8)" style="-fx-font-size: 11px;"/>
                <Label text="🔴 Furioso (30×Nv) — +Atq, +AtqEsp, +Vel" textFill="rgba(255,255,255,0.8)" style="-fx-font-size: 11px;"/>
                <Label text="🟢 Funcional (40×Nv) — +Vel, +Atq, +Def, +Vida" textFill="rgba(255,255,255,0.8)" style="-fx-font-size: 11px;"/>
                <Label text="🔵 Onirico (40×Nv) — +Vel, +AtqEsp, +DefEsp, +Vida" textFill="rgba(255,255,255,0.8)" style="-fx-font-size: 11px;"/>
            </VBox>

            <!-- Resultado del entrenamiento -->
            <TextArea fx:id="txtResultado"
                editable="false"
                prefHeight="80.0"
                wrapText="true"
                style="-fx-control-inner-background: rgba(0,0,0,0.5);
                       -fx-text-fill: #ffffff;
                       -fx-background-radius: 8;
                       -fx-font-size: 12px;" />

            <!-- Botones -->
            <HBox spacing="16.0" alignment="CENTER">

                <!-- Boton Entrenar -->
                <Button fx:id="btnEntrenar" text="ENTRENAR"
                    onAction="#handleEntrenar"
                    prefWidth="300.0" prefHeight="55.0"
                    style="-fx-background-color: linear-gradient(to bottom, #e8a000, #c87000);
                           -fx-text-fill: white;
                           -fx-font-family: 'Pokemon Solid Normal';
                           -fx-font-size: 16px;
                           -fx-background-radius: 12;
                           -fx-border-color: #a05000;
                           -fx-border-width: 0 0 4 0;
                           -fx-border-radius: 12;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 6, 0.2, 0, 3);" />

                <!-- Boton Volver -->
                <Button text="VOLVER"
                    onAction="#volverAlMenu"
                    prefWidth="300.0" prefHeight="55.0"
                    style="-fx-background-color: rgba(255,255,255,0.1);
                           -fx-text-fill: white;
                           -fx-font-family: 'Pokemon Solid Normal';
                           -fx-font-size: 16px;
                           -fx-background-radius: 12;
                           -fx-border-color: rgba(255,255,255,0.3);
                           -fx-border-width: 1;
                           -fx-border-radius: 12;
                           -fx-cursor: hand;" />
            </HBox>

        </VBox>

    </AnchorPane>
</StackPane>
