                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Button fx:id="btnBuscarSi" alignment="CENTER" mnemonicParsing="false" onAction="#handleBuscarOtroPokemon" prefHeight="50.0" prefWidth="200.0" style="-fx-text-fill: white; -fx-font-weight: bold;                                        -fx-font-size: 16px; -fx-background-radius: 25;                                        -fx-border-radius: 25; -fx-padding: 10 20;                                        -fx-border-color: #ffffff; -fx-border-width: 2;                                        -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.5),5,0.3,0,2);                                        -fx-background-color: rgba(76,175,80,0.8);" text="Si" visible="false" />
                        <Button fx:id="btnBuscarNo" alignment="CENTER" mnemonicParsing="false" onAction="#moteAsignadoNoRepetir" prefHeight="50.0" prefWidth="200.0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 25; -fx-border-radius: 25; -fx-padding: 10 20; -fx-border-color: #ffffff; -fx-border-width: 2; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.5),5,0.3,0,2); -fx-background-color: rgb(255,0,0,0.8);" text="No (Salir al menú)" visible="false">
