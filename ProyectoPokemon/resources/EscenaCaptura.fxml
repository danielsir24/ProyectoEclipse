                  </Label>
                  <Label fx:id="lblNivel" alignment="CENTER" prefHeight="96.0" prefWidth="228.0" style="-fx-text-fill: white; -fx-font-size: 16; -fx-effect: dropshadow(gaussian, black, 2, 1, 0, 0);" text="Nivel. XX">
