               <children>
                  <Label fx:id="lblBuscar" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="100.0" prefWidth="530.0" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, black, 2, 1, 0, 0);" text="¿Quieres buscar otro Pokémon?" visible="false">
                     <padding>
                        <Insets right="10.0" />
                     </padding>
