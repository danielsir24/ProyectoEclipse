               </image>
            </ImageView>
            <HBox layoutX="526.0" layoutY="14.0" prefHeight="56.0" prefWidth="263.0" style="-fx-background-color: rgba(0, 0, 0, 0.6);; -fx-background-radius: 10; -fx-padding: 10;">
