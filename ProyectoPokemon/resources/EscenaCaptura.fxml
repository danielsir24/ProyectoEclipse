                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextArea>
            <Button fx:id="btnMote" alignment="CENTER" layoutX="779.0" layoutY="118.0" mnemonicParsing="false" onAction="#handleGuardarMote" prefHeight="50.0" prefWidth="200.0" style="-fx-text-fill: white; -fx-font-weight: bold;                                        -fx-font-size: 16px; -fx-background-radius: 25;                                        -fx-border-radius: 25; -fx-padding: 10 20;                                        -fx-border-color: #ffffff; -fx-border-width: 2;                                        -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.5),5,0.3,0,2);                                        -fx-background-color: rgba(76,175,80,0.8);" text="Guardar mote" visible="false" />
            <Label fx:id="lblMote" alignment="CENTER" layoutX="563.0" layoutY="97.0" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="26.0" prefWidth="190.0" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, black, 2, 1, 0, 0);" text="¡Añade un mote!" visible="false">
               <padding>
